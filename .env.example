PORT=3333
JWT_SECRET=troque-por-um-segredo-grande
# origens do front (Vite do Figma Make usa 8443; Vite padrão usa 5173)
CORS_ORIGIN=http://localhost:8443,http://localhost:5173
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/tempoalerta
TZ_APP=America/Sao_Paulo
# SCHEDULER=off desliga os envios automáticos
SCHEDULER=on

# off = sem e-mail | smtp = entrega por SMTP | resend = API HTTPS do Resend
MAIL_MODE=off
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
MAIL_FROM="TempoAlerta <no-reply@tempoalerta.app>"

# Telegram (crie o bot com @BotFather; nunca coloque o token no front-end)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=TempoAlertaBot
